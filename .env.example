# ------------------------------------------------------------------
# FreshDocs environment variables.
# Copy to .env.local and fill in:  cp .env.example .env.local
# ------------------------------------------------------------------

# Password for the /admin dashboard. POST /api/login with this password to
# get a signed session cookie. (Default when unset: "admin" — change it.)
ADMIN_PASSWORD=changeme

# Optional: where the SQLite database file lives.
# Default: ./data/freshdocs.db  (the ./data directory is gitignored)
# DB_PATH=./data/freshdocs.db

# Database backend: unset (or anything but "d1") = local better-sqlite3 file
# (`npm run dev`). Set DB_BACKEND=d1 ONLY on Cloudflare Workers, where the
# [[d1_databases]] binding named DB (see wrangler.toml) is used instead.
# DB_BACKEND=d1

# ------------------------------------------------------------------
# LLM — any OpenAI-compatible chat-completions API.
# Everything still works WITHOUT a key: staleness checks fall back to a
# line-diff heuristic and chat answers fall back to extractive snippets.
# ------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
